# Anthropic
ANTHROPIC_API_KEY=your-api-key-here

# Google service account (see README setup, step 1)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# The spreadsheet holding the "Invoice Log" tab
INVOICE_SHEET_ID=your-google-sheet-id

# A SEPARATE spreadsheet holding the vendor master list (its first/only tab
# is read regardless of what it's named)
VENDOR_MASTER_SHEET_ID=your-vendor-master-sheet-id

# Drive folder to watch for new invoice files
DRIVE_WATCH_FOLDER_ID=your-drive-folder-id

# Gmail search query used to find new invoice emails. Already-read mail is
# included on purpose (no is:unread) — how far back it looks is controlled by
# EMAIL_CHECK_START_DATE / the rolling checkpoint below, not read status.
GMAIL_QUERY=has:attachment label:Invoices

# The very first run has no checkpoint yet, so it needs a starting point:
# only emails on/after this date are considered. Format YYYY-MM-DD. Leave
# unset to default to today (i.e. don't crawl mailbox history older than the
# agent's first run). Every run after the first ignores this and instead
# resumes from exactly where the previous run left off (see
# state/gmail_last_checked.json) — e.g. if the last run checked at 3pm,
# the next run starts from 3pm onward, not from this date again.
EMAIL_CHECK_START_DATE=2026-08-23

# Where "needs review" alerts get sent
NOTIFY_EMAIL=you@company.com

# How many invoices to extract concurrently in one run (each is an independent
# Claude call). Raise this for larger batches, but stay under your Anthropic
# rate limit — check your tier's requests-per-minute before increasing.
MAX_CONCURRENT_EXTRACTIONS=4
